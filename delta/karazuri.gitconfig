# Generated by karazuri/palette (scripts/build.py) from palette.json. Do not edit by hand.
# Include this file from ~/.gitconfig, then set [delta] features = karazuri-umi (or yoru, kami).

[delta "karazuri-umi"]
    dark = true
    syntax-theme = karazuri-umi
    plus-style = syntax "#24352A"
    plus-emph-style = syntax "#445B40"
    plus-non-emph-style = syntax "#24352A"
    minus-style = syntax "#3A2228"
    minus-emph-style = syntax "#6E3942"
    minus-non-emph-style = syntax "#3A2228"
    line-numbers-plus-style = "#8FB573"
    line-numbers-minus-style = "#E8707E"
    line-numbers-zero-style = "#54546D"
    line-numbers-left-style = "#54546D"
    line-numbers-right-style = "#54546D"
    file-style = "#82A8E8" bold
    file-decoration-style = "#54546D" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#54546D" box
    hunk-header-file-style = "#82A8E8"
    hunk-header-line-number-style = "#F0A35E"
    commit-decoration-style = "#54546D" box
    blame-palette = "#1A1A22 #1E1E27 #22222C #2A2A37"

[delta "karazuri-yoru"]
    dark = true
    syntax-theme = karazuri-yoru
    plus-style = syntax "#1F2A1F"
    plus-emph-style = syntax "#42513C"
    plus-non-emph-style = syntax "#1F2A1F"
    minus-style = syntax "#2F1C1E"
    minus-emph-style = syntax "#62383B"
    minus-non-emph-style = syntax "#2F1C1E"
    line-numbers-plus-style = "#94AD7E"
    line-numbers-minus-style = "#D9787F"
    line-numbers-zero-style = "#4A4744"
    line-numbers-left-style = "#4A4744"
    line-numbers-right-style = "#4A4744"
    file-style = "#8BA4C7" bold
    file-decoration-style = "#4A4744" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#4A4744" box
    hunk-header-file-style = "#8BA4C7"
    hunk-header-line-number-style = "#E09B5E"
    commit-decoration-style = "#4A4744" box
    blame-palette = "#161514 #1A1918 #1E1D1B #262523"

[delta "karazuri-kami"]
    light = true
    syntax-theme = karazuri-kami
    plus-style = syntax "#BFC9AD"
    plus-emph-style = syntax "#95AA82"
    plus-non-emph-style = syntax "#BFC9AD"
    minus-style = syntax "#D5BAB8"
    minus-emph-style = syntax "#C49092"
    minus-non-emph-style = syntax "#D5BAB8"
    line-numbers-plus-style = "#34611E"
    line-numbers-minus-style = "#9D2F3B"
    line-numbers-zero-style = "#8D8777"
    line-numbers-left-style = "#8D8777"
    line-numbers-right-style = "#8D8777"
    file-style = "#2B497A" bold
    file-decoration-style = "#989280" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#989280" box
    hunk-header-file-style = "#2B497A"
    hunk-header-line-number-style = "#82450B"
    commit-decoration-style = "#989280" box
    blame-palette = "#D2CCBC #CDC7B6 #CAC3B1 #C2BBA8"
