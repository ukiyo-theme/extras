# Ukiyo Kami. Generated by ukiyo-theme/palette (scripts/build.py) from palette.json. Do not edit by hand.
# Load it with: source-file /path/to/ukiyo-kami.tmux

set -g status-style "fg=#3F3E49,bg=#C8C2B0"
set -g status-left-style "fg=#D2CCBC,bg=#2B497A,bold"
set -g status-right-style "fg=#3F3E49,bg=#C2BBA8"
set -g window-status-style "fg=#595750,bg=#C8C2B0"
set -g window-status-current-style "fg=#292830,bg=#D2CCBC,bold"
set -g window-status-activity-style "fg=#82450B,bg=#C8C2B0"
set -g window-status-bell-style "fg=#981F2E,bg=#C8C2B0,bold"
set -g pane-border-style "fg=#989280"
set -g pane-active-border-style "fg=#2B497A"
set -g message-style "fg=#292830,bg=#C2BBA8"
set -g message-command-style "fg=#292830,bg=#C2BBA8"
set -g mode-style "fg=#292830,bg=#B2BAC8"
set -g copy-mode-match-style "fg=#292830,bg=#A2B0C6"
set -g copy-mode-current-match-style "fg=#D2CCBC,bg=#82450B"
set -g display-panes-colour "#989280"
set -g display-panes-active-colour "#2B497A"
set -g clock-mode-colour "#2B497A"
