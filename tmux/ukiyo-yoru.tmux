# Ukiyo Yoru. Generated by ukiyo-theme/palette (scripts/build.py) from palette.json. Do not edit by hand.
# Load it with: source-file /path/to/ukiyo-yoru.tmux

set -g status-style "fg=#B5B0A3,bg=#0F0F0E"
set -g status-left-style "fg=#0F0F0E,bg=#8BA4C7,bold"
set -g status-right-style "fg=#B5B0A3,bg=#262523"
set -g window-status-style "fg=#A09A8F,bg=#0F0F0E"
set -g window-status-current-style "fg=#D2CDBF,bg=#161514,bold"
set -g window-status-activity-style "fg=#E09B5E,bg=#0F0F0E"
set -g window-status-bell-style "fg=#E0616A,bg=#0F0F0E,bold"
set -g pane-border-style "fg=#4A4744"
set -g pane-active-border-style "fg=#8BA4C7"
set -g message-style "fg=#D2CDBF,bg=#262523"
set -g message-command-style "fg=#D2CDBF,bg=#262523"
set -g mode-style "fg=#D2CDBF,bg=#2B3240"
set -g copy-mode-match-style "fg=#D2CDBF,bg=#3B4659"
set -g copy-mode-current-match-style "fg=#0F0F0E,bg=#E09B5E"
set -g display-panes-colour "#4A4744"
set -g display-panes-active-colour "#8BA4C7"
set -g clock-mode-colour "#8BA4C7"
