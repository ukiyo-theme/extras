# karazuri Umi. Generated by karazuri/palette (scripts/build.py) from palette.json. Do not edit by hand.
# Load it with: source-file /path/to/karazuri-umi.tmux

set -g status-style "fg=#C8C093,bg=#14141B"
set -g status-left-style "fg=#14141B,bg=#82A8E8,bold"
set -g status-right-style "fg=#C8C093,bg=#2A2A37"
set -g window-status-style "fg=#ABAAA4,bg=#14141B"
set -g window-status-current-style "fg=#E2DCC5,bg=#1A1A22,bold"
set -g window-status-activity-style "fg=#F0A35E,bg=#14141B"
set -g window-status-bell-style "fg=#F2616E,bg=#14141B,bold"
set -g pane-border-style "fg=#54546D"
set -g pane-active-border-style "fg=#82A8E8"
set -g message-style "fg=#E2DCC5,bg=#2A2A37"
set -g message-command-style "fg=#E2DCC5,bg=#2A2A37"
set -g mode-style "fg=#E2DCC5,bg=#2D3F5C"
set -g copy-mode-match-style "fg=#E2DCC5,bg=#3D5378"
set -g copy-mode-current-match-style "fg=#14141B,bg=#F0A35E"
set -g display-panes-colour "#54546D"
set -g display-panes-active-colour "#82A8E8"
set -g clock-mode-colour "#82A8E8"
